# Copie este arquivo para ".env" e preencha os valores.
# Sem TURSO_URL e TURSO_TOKEN o servidor usa o SQLite local (tarefas.db).

# Banco na nuvem (Turso). Os dois precisam estar preenchidos juntos.
TURSO_URL=
TURSO_TOKEN=

# Segredo usado para assinar os tokens JWT. Em produção use um valor longo e aleatório.
JWT_SECRET=

# Porta da API (opcional, padrão 3000).
PORT=3000
